{
  "name": "indonesia-qris-react",
  "version": "1.0.4",
  "description": "Library untuk mengubah QRIS statis menjadi dinamis lengkap dengan UI dan kapabilitas membaca gambar QRIS untuk React",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test"
  },
  "keywords": [
    "qris",
    "react",
    "qris-dinamis",
    "indonesia"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0 || ^19.0.0",
    "@types/react-dom": "^18.2.0 || ^19.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
